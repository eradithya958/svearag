  "id": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "SveaRAG Assistant Telemetry & Performance Overview",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Total RAG Queries (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(rag_requests_total[1m])",
          "legendFormat": "{{status}} ({{endpoint}})"
        }
      ]
    },
    {
      "id": 2,
      "title": "End-to-End Latency Percentiles (P50, P90, P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum(rate(rag_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P50 Latency"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.90, sum(rate(rag_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P90 Latency"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum(rate(rag_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P99 Latency"
        }
      ]
    },
    {
      "id": 3,
      "title": "Indexed Public Documents",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rag_indexed_documents",
          "legendFormat": "Documents"
        }
      ]
    },
    {
      "id": 4,
      "title": "Retrieval vs LLM Generation Latency (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(rag_retrieval_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95 Retrieval Time"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(rag_llm_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95 LLM Inference Time"
        }
      ]
    },
    {
      "id": 5,
      "title": "User Feedback Ratio (Thumbs Up vs Thumbs Down)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (rating) (rag_feedback_total)",
          "legendFormat": "{{rating}}"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["svearag", "observability"],
  "time": { "from": "now-15m", "to": "now" },
